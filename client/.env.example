# Vite development proxy. The browser sends same-origin requests through Vite.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
# Optional for a separately hosted client; include /api/v1 and configure backend CORS.
# VITE_API_BASE_URL=https://your-api.example.com/api/v1
# All VITE_ variables are public. Never put AI provider keys or JWT signing secrets here.
