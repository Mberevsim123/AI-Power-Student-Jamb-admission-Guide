# development | test | production. Production refuses DEBUG=true and placeholder secrets.
ENVIRONMENT=development
DEBUG=true
APP_NAME=JAMB Guide API
# Generate a local secret: python -c 'import secrets; print(secrets.token_urlsafe(48))'
SECRET_KEY=replace-with-a-random-local-secret
# postgres:// and postgresql:// URLs (e.g. from Railway) are converted to asyncpg automatically.
DATABASE_URL=postgresql+asyncpg://jamb:jamb_dev@localhost:5432/jamb_db
LLM_PROVIDER=groq
LLM_MODEL=
# Groq is first; add fallback keys as needed. Keep all keys on the backend.
GEMINI_API_KEY=
GEMINI_WEB_SEARCH_ENABLED=true
GEMINI_MAX_OUTPUT_TOKENS=4096
GROQ_API_KEY=
LLM_TIMEOUT_SECONDS=20
INTENT_LLM_FALLBACK=false
CHAT_HISTORY_MESSAGES=20
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384
VECTOR_STORE=qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=jamb_docs_minilm_384
RAG_TOP_K=3
RAG_SCORE_THRESHOLD=0.35
REDIS_URL=redis://localhost:6379/0
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
LLM_FALLBACK_PROVIDERS=["gemini","openai","anthropic"]
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_MODEL=gemini-3.8-flash
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_MODEL=claude-sonnet-4-6
LLM_FAILOVER_TIMEOUT_SECONDS=60
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
